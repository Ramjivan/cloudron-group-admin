{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env --allow-write --unstable-kv main.ts",
    "dev": "deno run --allow-net --allow-read --allow-env --allow-write --unstable-kv --watch --reload main.ts"
  },
  "deploy": {
    "org": "ramjivan",
    "app": "cloudron-group-admin"
  }
}